{
  "name": "@yj/stencil-ui-kit",
  "version": "0.0.0",
  "description": "Stencil UI Component Library",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist/",
    "loader/"
  ],
  "workspaces": [
    "packages/*",
    "playground/*"
  ],
  "scripts": {
    "clean": "lerna clean -y",
    "watch": "lerna run watch --stream",
    "build": "npm run build:stencil && npm run build:vue && npm run build:react",
    "build:stencil": "lerna run build --scope @design-system/stencil",
    "build:vue": "lerna run build --scope @design-system/vue",
    "build:react": "lerna run build --scope @design-system/react",
    "build:rest": "lerna run build --ignore @design-system/stencil --concurrency=2",
    "dev:stencil": "lerna run start --scope @design-system/stencil --stream",
    "dev:react": "lerna run dev --scope react-dev --stream",
    "dev:vue": "lerna run dev --scope vue-dev --stream",
    "dev": "lerna run dev:start --stream"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "lerna": "^9.0.0",
    "typescript": "^5.9.3"
  }
}
